# Server
PORT=3001
HOST=0.0.0.0

# PostgreSQL connection (set by orchestrator)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=office_employee_db

# Optional pool tuning
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT=30000
PGPOOL_CONN_TIMEOUT=5000

# Enable SSL if required by environment
PGSSL=false
